{
  "$id": "https://clavis.example/records.schema.json",
  "title": "Clavis records import file",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "clavis-records/1"
    },
    "source": {
      "description": "Where these records came from, kept in the audit log.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "universities": {
      "default": [],
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Lowercase letters, digits and dashes, e.g. \"demo-university-1\". Unique per record type."
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "tk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": ["en"],
            "additionalProperties": false,
            "description": "The name in English (required), Turkmen and Russian."
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 code of a country already in Clavis, e.g. \"TR\"."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["public", "private"]
              },
              {
                "type": "null"
              }
            ]
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "A full http(s) address."
              },
              {
                "type": "null"
              }
            ]
          },
          "ministry_status": {
            "default": "unchecked",
            "description": "\"approved\" only with ministry_basis. Defaults to \"unchecked\".",
            "type": "string",
            "enum": ["approved", "not_listed", "unchecked"]
          },
          "ministry_basis": {
            "description": "Which Ministry list, order or letter, e.g. \"QS 2026 position 312\".",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "rankings": {
            "type": "object",
            "properties": {
              "qs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "the": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "arwu": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "moscow": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "source_url": {
            "description": "The official page the facts were checked on. Needed before an admin can publish.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "A full http(s) address."
              },
              {
                "type": "null"
              }
            ]
          },
          "last_checked": {
            "description": "When the facts were checked. Defaults to the import day.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": ["slug", "name", "country", "city"],
        "additionalProperties": false
      }
    },
    "colleges": {
      "default": [],
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Lowercase letters, digits and dashes, e.g. \"demo-university-1\". Unique per record type."
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "tk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": ["en"],
            "additionalProperties": false,
            "description": "The name in English (required), Turkmen and Russian."
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 code of a country already in Clavis, e.g. \"TR\"."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "A full http(s) address."
              },
              {
                "type": "null"
              }
            ]
          },
          "source_url": {
            "description": "The official page the facts were checked on. Needed before an admin can publish.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "A full http(s) address."
              },
              {
                "type": "null"
              }
            ]
          },
          "last_checked": {
            "description": "When the facts were checked. Defaults to the import day.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": ["slug", "name", "country", "city"],
        "additionalProperties": false
      }
    },
    "programs": {
      "default": [],
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Lowercase letters, digits and dashes, e.g. \"demo-university-1\". Unique per record type."
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "tk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": ["en"],
            "additionalProperties": false,
            "description": "The name in English (required), Turkmen and Russian."
          },
          "university": {
            "description": "Slug of the university that teaches it.",
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "college": {
            "description": "Slug of the pathway college, instead of a university.",
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "level": {
            "type": "string",
            "enum": ["bachelor", "foundation", "language"]
          },
          "field": {
            "description": "Field of study; leave out for language years.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "business",
                  "computing",
                  "engineering",
                  "medicine",
                  "law",
                  "sciences",
                  "social_sciences",
                  "arts",
                  "education",
                  "architecture"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "language_of_study": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "description": "ISO 639-1 code, e.g. \"en\"."
          },
          "duration_years": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 8
          },
          "tuition_per_year_usd": {
            "description": "Leave out or null when not confirmed. Never an estimate.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "intakes": {
            "default": [],
            "description": "Start months, 1–12.",
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "application_deadline": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "A date as YYYY-MM-DD."
              },
              {
                "type": "null"
              }
            ]
          },
          "pre_year_required": {
            "description": "Bachelor's only: does a school-leaver from Turkmenistan need a pre-year first?",
            "type": "string",
            "enum": ["yes", "no", "unknown"]
          },
          "requirements": {
            "type": "object",
            "properties": {
              "ielts_min": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "other_tests": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "min": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["name"],
                  "additionalProperties": false
                }
              },
              "documents": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "passport",
                    "school_certificate",
                    "transcript",
                    "motivation_letter",
                    "recommendation_letter",
                    "cv",
                    "portfolio",
                    "medical_certificate",
                    "photos",
                    "application_fee"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "source_url": {
            "description": "The official page the facts were checked on. Needed before an admin can publish.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "A full http(s) address."
              },
              {
                "type": "null"
              }
            ]
          },
          "last_checked": {
            "description": "When the facts were checked. Defaults to the import day.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": ["slug", "name", "level", "language_of_study", "duration_years"],
        "additionalProperties": false
      }
    },
    "pathways": {
      "default": [],
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Slug of a foundation or language program."
          },
          "to": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Slug of a bachelor's program."
          },
          "entry_guaranteed": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    },
    "scholarships": {
      "default": [],
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Lowercase letters, digits and dashes, e.g. \"demo-university-1\". Unique per record type."
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "tk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": ["en"],
            "additionalProperties": false,
            "description": "The name in English (required), Turkmen and Russian."
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 code of a country already in Clavis, e.g. \"TR\"."
          },
          "coverage": {
            "type": "string",
            "enum": ["full", "partial"]
          },
          "covers": {
            "default": [],
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["tuition", "stipend", "housing", "flights", "insurance"]
            }
          },
          "covers_pre_year": {
            "default": "unknown",
            "type": "string",
            "enum": ["yes", "no", "unknown"]
          },
          "amount_text": {
            "description": "As the provider says it, e.g. \"€1,200 a month\".",
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "tk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": ["en"],
            "additionalProperties": false
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "A date as YYYY-MM-DD."
              },
              {
                "type": "null"
              }
            ]
          },
          "rolling": {
            "default": false,
            "type": "boolean"
          },
          "open_to_turkmen": {
            "default": "unknown",
            "type": "string",
            "enum": ["yes", "no", "unknown"]
          },
          "eligibility": {
            "description": "One condition per item.",
            "type": "object",
            "properties": {
              "en": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "tk": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "ru": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            },
            "required": ["en"],
            "additionalProperties": false
          },
          "how_to_apply": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "tk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": ["en"],
            "additionalProperties": false
          },
          "programs": {
            "default": [],
            "description": "Slugs of bachelor's programs it can be used at.",
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Lowercase letters, digits and dashes, e.g. \"demo-university-1\". Unique per record type."
            }
          },
          "universities": {
            "default": [],
            "description": "Slugs of universities where it works for every bachelor's program.",
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Lowercase letters, digits and dashes, e.g. \"demo-university-1\". Unique per record type."
            }
          },
          "source_url": {
            "description": "The official page the facts were checked on. Needed before an admin can publish.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "A full http(s) address."
              },
              {
                "type": "null"
              }
            ]
          },
          "last_checked": {
            "description": "When the facts were checked. Defaults to the import day.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": ["slug", "name", "provider", "country", "coverage"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format"],
  "additionalProperties": false
}
