---
/**
 * One tracked application: stage, path steps, deadline (with the student's own
 * date), checklist, notes, share, stop tracking. Plain forms posting to
 * /api/tracker/*, which come back here, so all of it works without JavaScript.
 * Each form returns to its own anchor so the page doesn't jump to the top.
 */
import '../../../../styles/tracker.css';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import PathSteps from '../../../../components/PathSteps.astro';
import Text from '../../../../components/Text.astro';
import { getTranslations, isLang } from '../../../../i18n';
import MyLayout from '../../../../layouts/MyLayout.astro';
import { ensureProfile } from '../../../../lib/account';
import { getSignedIn } from '../../../../lib/auth/server';
import { myPath, signInPath } from '../../../../lib/auth/urls';
import { TRACKER_STAGES } from '../../../../lib/db/values';
import { formatDate } from '../../../../lib/format';
import { getDb, today } from '../../../../lib/server';
import { getTrackerItem, MAX_NOTES, MAX_TASK_TITLE, taskLabel } from '../../../../lib/tracker';
import { itemDeadlineText, progressText, stageLabel } from '../../../../lib/tracker-view';
import { levelLabel } from '../../../../lib/view';

export const prerender = false;

const { lang, id } = Astro.params;
if (!isLang(lang)) return new Response(null, { status: 404 });
const t = getTranslations(lang);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const signedIn = await getSignedIn(Astro.request.headers, Astro.response.headers);
if (!signedIn) return Astro.redirect(signInPath(lang, { next: Astro.url.pathname }), 303);
const db = getDb();
await ensureProfile(db, signedIn.user.id, lang);

const itemId = Number(id);
const found =
  Number.isInteger(itemId) && itemId > 0
    ? await getTrackerItem(db, signedIn.user.id, itemId, lang)
    : null;
if (!found) Astro.response.status = 404;
const now = today();
const here = Astro.url.pathname;
const error = Astro.url.searchParams.get('error');
const item = found?.item;
const tasks = found?.tasks ?? [];
const typeLabel = item
  ? item.type === 'scholarship'
    ? t('tracker.type.scholarship')
    : item.type === 'pathway'
      ? t('tracker.type.pathway')
      : levelLabel(t, item.steps[0]?.level ?? 'bachelor')
  : '';
---

<MyLayout lang={lang} tab="" title={item ? `${item.name.text} · ${t('my.title')}` : undefined}>
  <Breadcrumb
    lang={lang}
    items={[{ href: myPath(lang), label: t('my.tab.tracker') }]}
    current={item?.name.text ?? t('tracker.notFound')}
  />
  {!item ? (
    <div class="card gone">
      <h2 class="section-title">{t('tracker.notFound')}</h2>
      <a class="button" href={myPath(lang)}>
        {t('tracker.backToTracker')}
      </a>
    </div>
  ) : (
    <article class="item">
      <header class="head">
        <span class="badge badge-plain">{typeLabel}</span>
        <h2 class="item-title">
          {item.path ? (
            <a href={`/${lang}${item.path}`}>
              <Text value={item.name} lang={lang} />
            </a>
          ) : (
            <Text value={item.name} lang={lang} />
          )}
        </h2>
        {item.provider && <p class="text-muted">{item.provider.text}</p>}
        {!item.path && <p class="notice">{t('tracker.unlisted')}</p>}
      </header>

      {error && (
        <p class="notice" role="alert">
          {error === 'rate'
            ? t('tracker.error.rate')
            : error === 'limit'
              ? t('tracker.error.taskLimit')
              : t('tracker.error.generic')}
        </p>
      )}

      <section id="stage" class="card block" aria-labelledby="stage-title">
        <h3 id="stage-title" class="section-title">
          {t('tracker.stage')}
        </h3>
        <form method="post" action="/api/tracker/item" class="row">
          <input type="hidden" name="action" value="stage" />
          <input type="hidden" name="id" value={String(item.id)} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="back" value={`${here}#stage`} />
          <label class="visually-hidden" for="stage-select">
            {t('tracker.stage')}
          </label>
          <select id="stage-select" name="stage" class="input grow">
            {TRACKER_STAGES.map((s) => (
              <option value={s} selected={s === item.stage}>
                {stageLabel(t, s)}
              </option>
            ))}
          </select>
          <button type="submit" class="button">
            {t('tracker.change')}
          </button>
        </form>
      </section>

      {item.steps.length > 0 && (
        <section class="card block" aria-labelledby="steps-title">
          <h3 id="steps-title" class="section-title">
            {t('path.title')}
          </h3>
          <PathSteps
            lang={lang}
            totalYears={item.totalYears}
            steps={item.steps.map((step) => ({
              level: step.level,
              name: step.name,
              provider: item.steps.length > 1 ? step.provider : undefined,
              href: step.path ? `/${lang}${step.path}` : undefined,
              years: step.years,
            }))}
          />
        </section>
      )}

      <section id="deadline" class="card block" aria-labelledby="deadline-title">
        <h3 id="deadline-title" class="section-title">
          {t('tracker.deadline')}
        </h3>
        <p class="deadline-now">{itemDeadlineText(t, lang, item, now)}</p>
        {item.deadlineOverridden && (
          <p class="muted-note">
            {t('tracker.ownDate')}
            {' · '}
            {item.sourceDeadline
              ? t('tracker.recordDate', { date: formatDate(lang, item.sourceDeadline) })
              : t('tracker.recordDateUnknown')}
          </p>
        )}
        <form method="post" action="/api/tracker/item" class="row">
          <input type="hidden" name="action" value="deadline" />
          <input type="hidden" name="id" value={String(item.id)} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="back" value={`${here}#deadline`} />
          <div class="field grow">
            <label for="deadline-input">{t('tracker.setDate')}</label>
            <input
              id="deadline-input"
              class="input"
              type="date"
              name="deadline"
              value={item.deadlineOverridden ? (item.deadline ?? '') : ''}
            />
          </div>
          <button type="submit" class="button button-secondary">
            {t('tracker.saveDate')}
          </button>
        </form>
        {item.deadlineOverridden && (
          <form method="post" action="/api/tracker/item">
            <input type="hidden" name="action" value="deadline" />
            <input type="hidden" name="id" value={String(item.id)} />
            <input type="hidden" name="deadline" value="" />
            <input type="hidden" name="lang" value={lang} />
            <input type="hidden" name="back" value={`${here}#deadline`} />
            <button type="submit" class="button button-quiet">
              {t('tracker.useRecordDate')}
            </button>
          </form>
        )}
      </section>

      <section id="checklist" class="card block" aria-labelledby="checklist-title">
        <h3 id="checklist-title" class="section-title">
          {t('tracker.checklist')}
        </h3>
        <progress
          class="progress-bar"
          max={Math.max(item.total, 1)}
          value={item.done}
          aria-label={t('tracker.progressLabel')}
        ></progress>
        <p class="text-small text-muted">{progressText(t, item)}</p>
        {tasks.length === 0 ? (
          <p class="text-muted">{t('tracker.noTasks')}</p>
        ) : (
          <ul class="tasks">
            {tasks.map((task) => {
              const label = taskLabel(t, lang, task);
              return (
                <li id={`task-${task.id}`} class="task">
                  <form method="post" action="/api/tracker/task" class="task-toggle">
                    <input type="hidden" name="action" value="done" />
                    <input type="hidden" name="itemId" value={String(item.id)} />
                    <input type="hidden" name="taskId" value={String(task.id)} />
                    <input type="hidden" name="done" value={task.done ? '0' : '1'} />
                    <input type="hidden" name="lang" value={lang} />
                    <input type="hidden" name="back" value={`${here}#task-${task.id}`} />
                    <button
                      type="submit"
                      class="task-button"
                      aria-pressed={task.done ? 'true' : 'false'}
                    >
                      <span class="box" aria-hidden="true">
                        {task.done && (
                          <svg viewBox="0 0 24 24" width="18" height="18">
                            <path
                              d="M5 12l5 5 9-10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            ></path>
                          </svg>
                        )}
                      </span>
                      <span class="task-text">{label}</span>
                    </button>
                  </form>
                  <form method="post" action="/api/tracker/task">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="itemId" value={String(item.id)} />
                    <input type="hidden" name="taskId" value={String(task.id)} />
                    <input type="hidden" name="lang" value={lang} />
                    <input type="hidden" name="back" value={`${here}#checklist`} />
                    <button
                      type="submit"
                      class="button button-quiet"
                      aria-label={t('tracker.removeTaskLabel', { name: label })}
                    >
                      {t('tracker.removeTask')}
                    </button>
                  </form>
                </li>
              );
            })}
          </ul>
        )}
        <form method="post" action="/api/tracker/task" class="row">
          <input type="hidden" name="action" value="add" />
          <input type="hidden" name="itemId" value={String(item.id)} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="back" value={`${here}#checklist`} />
          <div class="field grow">
            <label for="task-title">{t('tracker.addTask')}</label>
            <input id="task-title" class="input" name="title" required maxlength={MAX_TASK_TITLE} />
          </div>
          <button type="submit" class="button button-secondary">
            {t('tracker.addTaskButton')}
          </button>
        </form>
      </section>

      <section id="notes" class="card block" aria-labelledby="notes-title">
        <h3 id="notes-title" class="section-title">
          {t('tracker.notes')}
        </h3>
        <form method="post" action="/api/tracker/item" class="stack-form">
          <input type="hidden" name="action" value="notes" />
          <input type="hidden" name="id" value={String(item.id)} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="back" value={`${here}#notes`} />
          <label class="visually-hidden" for="notes-input">
            {t('tracker.notes')}
          </label>
          <textarea
            id="notes-input"
            class="input"
            name="notes"
            rows="5"
            maxlength={MAX_NOTES}
          >{item.notes ?? ''}</textarea>
          <p class="muted-note">{t('tracker.notesPrivate')}</p>
          <button type="submit" class="button button-secondary">
            {t('tracker.saveNotes')}
          </button>
        </form>
      </section>

      <section class="card block" aria-labelledby="share-title">
        <h3 id="share-title" class="section-title">
          {t('share.title')}
        </h3>
        <p class="text-muted">{t('share.itemBody')}</p>
        <a class="button button-secondary" href={`/${lang}/my/share?item=${item.id}`}>
          {t('share.cta')}
        </a>
      </section>

      <section class="card block" aria-labelledby="stop-title">
        <h3 id="stop-title" class="section-title">
          {t('tracker.stop')}
        </h3>
        <form method="post" action="/api/tracker/item" class="stack-form">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={String(item.id)} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="back" value={here} />
          <label class="choice">
            <input type="checkbox" name="confirm" value="1" required />
            {t('tracker.stopConfirm')}
          </label>
          <button type="submit" class="button button-secondary">
            {t('tracker.stop')}
          </button>
        </form>
      </section>
    </article>
  )}
</MyLayout>

<style>
  .item {
    display: grid;
    gap: var(--space-4);
  }
  .head {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }
  .item-title {
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    overflow-wrap: anywhere;
  }
  .block {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
  }
  .grow {
    flex: 1 1 14rem;
    min-width: 0;
  }
  .stack-form {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }
  .stack-form textarea {
    resize: vertical;
  }
  .deadline-now {
    font-size: var(--text-title);
    line-height: var(--leading-title);
    font-weight: var(--weight-semibold);
  }
  .tasks {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .task {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    scroll-margin-top: var(--space-6);
  }
  .task-toggle {
    flex: 1 1 auto;
    min-width: 0;
  }
  .task-button {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--touch-target);
    padding: var(--space-2);
    border: 0;
    border-radius: var(--radius-input);
    background: transparent;
    color: var(--ink);
    text-align: start;
    cursor: pointer;
  }
  .box {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--ink-muted);
    border-radius: var(--radius-input);
    color: var(--on-brand);
  }
  .task-button[aria-pressed='true'] .box {
    border-color: var(--brand);
    background: var(--brand);
  }
  .task-button[aria-pressed='true'] .task-text {
    color: var(--ink-muted);
    text-decoration: line-through;
  }
  .task-text {
    overflow-wrap: anywhere;
  }
  .gone {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-5);
  }
  section[id] {
    scroll-margin-top: var(--space-6);
  }
</style>
