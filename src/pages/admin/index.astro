---
/**
 * /admin: what needs attention. Open queues, then records not checked for
 * 12 months (SPEC: "stale flags after 12 months").
 */
import { asc, lt, sql } from 'drizzle-orm';
import { getTranslations } from '../../i18n';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { staleBefore } from '../../lib/admin/form';
import { requireAdmin } from '../../lib/admin/guard';
import { queueCounts } from '../../lib/admin/queues';
import { pathwayColleges, programs, scholarships, universities } from '../../lib/db/schema';
import { getDb, today } from '../../lib/server';

export const prerender = false;

const admin = await requireAdmin(Astro.request, Astro.response.headers);
if (admin instanceof Response) return admin;
const { lang } = admin;
const t = getTranslations(lang);
const db = getDb();
const before = staleBefore(today());

const counts = await queueCounts(db);
const staleCount = async (
  table: typeof universities | typeof pathwayColleges | typeof programs | typeof scholarships,
) => {
  const [row] = await db
    .select({ n: sql<number>`count(*)` })
    .from(table)
    .where(lt(table.lastChecked, before));
  return Number(row?.n ?? 0);
};
const stale = [
  {
    href: '/admin/universities?stale=1',
    label: t('admin.type.universities'),
    n: await staleCount(universities),
  },
  {
    href: '/admin/colleges?stale=1',
    label: t('admin.type.colleges'),
    n: await staleCount(pathwayColleges),
  },
  {
    href: '/admin/programs?stale=1',
    label: t('admin.type.programs'),
    n: await staleCount(programs),
  },
  {
    href: '/admin/scholarships?stale=1',
    label: t('admin.type.scholarships'),
    n: await staleCount(scholarships),
  },
];
const oldest = await db
  .select({ id: programs.id, name: programs.name, lastChecked: programs.lastChecked })
  .from(programs)
  .where(lt(programs.lastChecked, before))
  .orderBy(asc(programs.lastChecked))
  .limit(5);
const queues = [
  { href: '/admin/mistakes', label: t('admin.queue.mistakes'), n: counts.mistakes },
  { href: '/admin/reports', label: t('admin.queue.reports'), n: counts.posts },
  { href: '/admin/badges', label: t('admin.queue.badges'), n: counts.badges },
];
---

<AdminLayout lang={lang} title={t('admin.overview')} section="/admin">
  <h1 class="page-title">{t('admin.overview')}</h1>
  <ul class="quick" aria-label={t('admin.nav.records')}>
    {(['universities', 'programs', 'pathways', 'scholarships'] as const).map((type) => (
      <li>
        <a class="button button-secondary" href={`/admin/${type}/new`}>
          + {t('admin.new', { what: t(`admin.one.${type}`) })}
        </a>
      </li>
    ))}
  </ul>
  <section class="stack" aria-labelledby="queues">
    <h2 id="queues" class="section-title">
      {t('admin.nav.queues')}
    </h2>
    <ul class="tiles">
      {queues.map((q) => (
        <li>
          <a class:list={['card tile', { waiting: q.n > 0 }]} href={q.href}>
            <span class="n">{q.n}</span>
            <span class="label">{q.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <section class="stack" aria-labelledby="stale">
    <h2 id="stale" class="section-title">
      {t('admin.staleTitle')}
    </h2>
    <p class="muted-note">{t('admin.staleHint')}</p>
    <ul class="tiles">
      {stale.map((s) => (
        <li>
          <a class:list={['card tile', { waiting: s.n > 0 }]} href={s.href}>
            <span class="n">{s.n}</span>
            <span class="label">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
    {oldest.length > 0 && (
      <ul class="oldest">
        {oldest.map((p) => (
          <li>
            <a href={`/admin/programs/${p.id}`}>{p.name}</a>{' '}
            <span class="muted-note">{p.lastChecked}</span>
          </li>
        ))}
      </ul>
    )}
  </section>
</AdminLayout>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    display: grid;
    gap: var(--space-1);
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    min-height: var(--touch-target);
  }
  .tile:hover {
    box-shadow: inset 0 0 0 2px var(--brand);
  }
  /* Something to do: the tile turns brand-soft so it stands out from the zeros. */
  .tile.waiting {
    background: var(--brand-soft);
    border-color: var(--brand-soft);
  }
  .n {
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-semibold);
  }
  .label {
    color: var(--ink-muted);
    font-weight: var(--weight-medium);
  }
  .oldest {
    display: grid;
    gap: var(--space-2);
  }
</style>
