---
/**
 * /admin: its own slim header and a list of sections instead of the public
 * nav. Rendered per request, never cached (middleware), never indexed.
 */
import Logo from '../components/Logo.astro';
import { getTranslations, type Lang, type MessageKey } from '../i18n';
import BaseLayout from './BaseLayout.astro';

interface Props {
  lang: Lang;
  title: string;
  /** Path of the current section, e.g. /admin/programs. */
  section: string;
}

const { lang, title, section } = Astro.props;
const t = getTranslations(lang);

const groups: { label: MessageKey; items: { href: string; label: MessageKey }[] }[] = [
  {
    label: 'admin.nav.records',
    items: [
      { href: '/admin/universities', label: 'admin.type.universities' },
      { href: '/admin/colleges', label: 'admin.type.colleges' },
      { href: '/admin/programs', label: 'admin.type.programs' },
      { href: '/admin/pathways', label: 'admin.type.pathways' },
      { href: '/admin/scholarships', label: 'admin.type.scholarships' },
    ],
  },
  {
    label: 'admin.nav.queues',
    items: [
      { href: '/admin/mistakes', label: 'admin.queue.mistakes' },
      { href: '/admin/reports', label: 'admin.queue.reports' },
      { href: '/admin/badges', label: 'admin.queue.badges' },
    ],
  },
  {
    label: 'admin.nav.site',
    items: [
      { href: '/admin/settings', label: 'admin.settings.title' },
      { href: '/admin/audit', label: 'admin.audit.title' },
    ],
  },
];
---

<BaseLayout lang={lang} title={`${title} · ${t('admin.title')}`} noindex>
  <a class="skip-link" href="#main">
    {t('a11y.skipToContent')}
  </a>
  <header class="admin-header">
    <a class="logo-link" href="/admin" aria-label={t('admin.title')}>
      <Logo size="small" />
      <span class="admin-name">{t('admin.short')}</span>
    </a>
    <a class="button button-quiet" href={`/${lang}`}>
      {t('admin.toSite')}
    </a>
  </header>
  <div class="admin">
    <nav class="admin-nav" aria-label={t('admin.nav.label')}>
      <a href="/admin" aria-current={section === '/admin' ? 'page' : undefined}>
        {t('admin.overview')}
      </a>
      {groups.map((group) => (
        <div class="group">
          <p class="group-label">{t(group.label)}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} aria-current={section === item.href ? 'page' : undefined}>
                  {t(item.label)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <main id="main" class="admin-main" tabindex="-1">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: var(--space-2);
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-button);
    background: var(--brand);
    color: var(--on-brand);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  .admin-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .logo-link {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    border-radius: var(--radius-chip);
    color: var(--ink);
    text-decoration: none;
  }
  .admin-name {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-badge);
    background: var(--brand);
    color: var(--on-brand);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: var(--weight-semibold);
  }
  .admin {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    max-width: 90rem;
    margin-inline: auto;
    padding: var(--space-4);
  }

  /* Phones: each group is a row of chips. */
  .admin-nav {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .admin-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .admin-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-chip);
    background: var(--surface-raised);
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .admin-nav a:hover {
    border-color: var(--brand);
  }
  .admin-nav a[aria-current='page'] {
    border-color: var(--brand-soft);
    background: var(--brand-soft);
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .admin-nav > a {
    justify-self: start;
  }
  .group {
    display: grid;
    gap: var(--space-2);
  }
  .group-label {
    color: var(--ink-muted);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Desktop: a sticky side panel with one row per section. */
  @media (min-width: 64rem) {
    .admin {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-6);
      padding: var(--space-5) var(--space-6);
    }
    .admin-nav {
      position: sticky;
      top: var(--space-4);
      gap: var(--space-4);
      padding: var(--space-3);
      border-radius: var(--radius-card);
      background: var(--surface-raised);
      border: 1px solid var(--border);
    }
    .admin-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .admin-nav a,
    .admin-nav > a {
      display: flex;
      justify-self: stretch;
      border: 0;
      background: none;
    }
    .admin-nav a:hover {
      background: var(--surface);
    }
    .admin-nav a[aria-current='page'] {
      background: var(--brand-soft);
    }
    .group-label {
      padding-inline: var(--space-3);
    }
  }
  .admin-main {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
</style>
