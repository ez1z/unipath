---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { LANGS, DEFAULT_LANG, getTranslations, localizePath, type Lang } from '../i18n';
import { THEME_COOKIE, THEME_SCRIPT, themeFromCookie } from '../lib/theme';

interface Props {
  lang: Lang;
  title: string;
  description?: string | undefined;
  /** Forms and share pages stay out of search engines. */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const t = getTranslations(lang);
const { pathname, origin } = Astro.url;
// Cached pages use the canonical query (lib/cache.ts), never the first visitor's raw one.
const canonicalQuery = Astro.locals.canonicalQuery;
const search =
  canonicalQuery === undefined ? Astro.url.search : canonicalQuery ? `?${canonicalQuery}` : '';
const urlFor = (path: string) => new URL(`${path}${search}`, origin).href;
// Only pages rendered per request for one visitor may read their cookie.
const perVisitor = !Astro.isPrerendered && canonicalQuery === undefined;
const theme = perVisitor ? themeFromCookie(Astro.cookies.get(THEME_COOKIE)?.value) : undefined;
---

<!doctype html>
<html lang={lang} dir="ltr" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={THEME_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description ?? t('meta.description')} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={urlFor(pathname)} />
    {LANGS.map((code) => (
      <link rel="alternate" hreflang={code} href={urlFor(localizePath(pathname, code))} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={urlFor(localizePath(pathname, DEFAULT_LANG))}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
