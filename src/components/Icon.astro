---
/** Line icons for navigation. Decorative: the visible label carries the meaning. */
interface Props {
  name: 'home' | 'universities' | 'scholarships' | 'discussions' | 'my';
}
const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'home' && (
    <>
      <path d="M3.5 10.5 12 3.5l8.5 7" />
      <path d="M5.5 9v11h13V9" />
      <path d="M10 20v-5.5h4V20" />
    </>
  )}
  {name === 'universities' && (
    <>
      <path d="M3 9.5 12 4.5l9 5" />
      <path d="M5.5 10.5v7M10 10.5v7M14 10.5v7M18.5 10.5v7" />
      <path d="M3.5 20.5h17" />
    </>
  )}
  {name === 'scholarships' && (
    <>
      <path d="M2.5 9 12 4.5 21.5 9 12 13.5z" />
      <path d="M6.5 11v4.5c0 1.6 2.5 3 5.5 3s5.5-1.4 5.5-3V11" />
      <path d="M21.5 9v5.5" />
    </>
  )}
  {name === 'discussions' && (
    <>
      <path d="M20.5 11.5a7.5 7.5 0 0 1-10.9 6.7L4 19.5l1.4-4.6a7.5 7.5 0 1 1 15.1-3.4z" />
      <path d="M9 10.5h6M9 13.5h4" />
    </>
  )}
  {name === 'my' && (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4.5 20.5c0-3.9 3.4-6.5 7.5-6.5s7.5 2.6 7.5 6.5" />
    </>
  )}
</svg>

<style>
  .icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
