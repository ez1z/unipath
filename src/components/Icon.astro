---
/** Line icons for navigation and trust notes. Decorative: the visible label carries the meaning. */
interface Props {
  name:
    | 'home'
    | 'universities'
    | 'scholarships'
    | 'discussions'
    | 'my'
    | 'shield'
    | 'no-ads'
    | 'gift'
    | 'send'
    | 'arrow';
}
const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'home' && (
    <>
      <path d="M3.5 10.5 12 3.5l8.5 7" />
      <path d="M5.5 9v11h13V9" />
      <path d="M10 20v-5.5h4V20" />
    </>
  )}
  {name === 'universities' && (
    <>
      <path d="M3 9.5 12 4.5l9 5" />
      <path d="M5.5 10.5v7M10 10.5v7M14 10.5v7M18.5 10.5v7" />
      <path d="M3.5 20.5h17" />
    </>
  )}
  {name === 'scholarships' && (
    <>
      <path d="M2.5 9 12 4.5 21.5 9 12 13.5z" />
      <path d="M6.5 11v4.5c0 1.6 2.5 3 5.5 3s5.5-1.4 5.5-3V11" />
      <path d="M21.5 9v5.5" />
    </>
  )}
  {name === 'discussions' && (
    <>
      <path d="M20.5 11.5a7.5 7.5 0 0 1-10.9 6.7L4 19.5l1.4-4.6a7.5 7.5 0 1 1 15.1-3.4z" />
      <path d="M9 10.5h6M9 13.5h4" />
    </>
  )}
  {name === 'my' && (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4.5 20.5c0-3.9 3.4-6.5 7.5-6.5s7.5 2.6 7.5 6.5" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3.5 5 6v5.5c0 4.3 3 7.6 7 9 4-1.4 7-4.7 7-9V6z" />
      <path d="m9 12 2.2 2.2L15.5 10" />
    </>
  )}
  {name === 'no-ads' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="m6 6 12 12" />
    </>
  )}
  {name === 'gift' && (
    <>
      <path d="M4.5 10.5h15v10h-15zM3.5 7.5h17v3h-17zM12 7.5v13" />
      <path d="M12 7.5C10.5 4 7 4 7 6s3 1.5 5 1.5c2 0 5 .5 5-1.5s-3.5-2-5 1.5" />
    </>
  )}
  {name === 'send' && <path d="M21 4 3.5 11l6.5 2.5L12.5 20zM10 13.5 21 4" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>

<style>
  .icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
