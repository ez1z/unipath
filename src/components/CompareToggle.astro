---
import { getTranslations, type Lang } from '../i18n';

/**
 * "Compare" toggle for one path to a bachelor's (`101` or `203-201`). Hidden
 * until CompareBar's script runs: picking needs JavaScript, the Compare page
 * itself doesn't.
 */
interface Props {
  lang: Lang;
  compareKey: string;
}
const { lang, compareKey } = Astro.props;
const t = getTranslations(lang);
---

<button
  type="button"
  class="compare-toggle"
  data-compare-key={compareKey}
  aria-pressed="false"
  hidden
>
  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
    <rect
      x="2.5"
      y="2.5"
      width="15"
      height="15"
      rx="3"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    ></rect>
    <path
      class="tick"
      d="M6 10.5l2.5 2.5L14 7.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    ></path>
  </svg>
  {t('compare.add')}
</button>

<style>
  .compare-toggle {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-chip);
    background: transparent;
    color: var(--brand);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  .compare-toggle[hidden] {
    display: none;
  }
  .tick {
    visibility: hidden;
  }
  .compare-toggle[aria-pressed='true'] {
    background: var(--brand-soft);
  }
  .compare-toggle[aria-pressed='true'] .tick {
    visibility: visible;
  }
</style>
