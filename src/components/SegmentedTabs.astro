---
/**
 * A two-or-more way switch made of links (each tab is its own URL, so it works
 * without JavaScript). Used for Programs / Universities on search, and the
 * section tabs on the university page.
 */
interface Props {
  label: string;
  items: { href: string; label: string; current: boolean }[];
  /** Section tabs scroll sideways on phones instead of sharing the width. */
  scroll?: boolean;
}
const { label, items, scroll = false } = Astro.props;
---

<nav class:list={['tabs', { scroll }]} aria-label={label}>
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.current ? 'page' : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabs ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    border-radius: var(--radius-button);
    background: var(--brand-soft);
  }
  .tabs li {
    flex: 1 1 0;
  }
  .scroll ul {
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .scroll li {
    flex: 0 0 auto;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: var(--space-1) var(--space-4);
    border-radius: calc(var(--radius-button) - 4px);
    color: var(--ink);
    font-weight: var(--weight-semibold);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }
  a[aria-current='page'] {
    background: var(--surface-raised);
    color: var(--brand);
    box-shadow: inset 0 0 0 2px var(--brand);
  }
</style>
