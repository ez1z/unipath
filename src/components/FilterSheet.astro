---
import { getTranslations, type Lang } from '../i18n';
import FilterPanel, { type FilterPanelProps } from '../islands/FilterPanel';

/**
 * Where the filters live: a bottom sheet on phones (opened by FiltersButton
 * through the Popover API, so no JavaScript is needed), a left column on desktop.
 */
interface Props {
  lang: Lang;
  panel: FilterPanelProps;
}
const { lang, panel } = Astro.props;
const t = getTranslations(lang);
const sheetId = `${panel.id}-sheet`;
---

<div id={sheetId} class="filter-sheet" popover="auto" aria-labelledby={`${sheetId}-title`}>
  <div class="sheet-header">
    <h2 id={`${sheetId}-title`} class="text-title">
      {t('search.filters')}
    </h2>
    <button
      type="button"
      class="sheet-close"
      popovertarget={sheetId}
      popovertargetaction="hide"
      aria-label={t('filter.close')}
    >
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </button>
  </div>
  <FilterPanel client:visible {...panel} />
</div>

<style is:global>
  /* Phone: a bottom sheet over the page. */
  .filter-sheet {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    max-height: 88dvh;
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
    border: 0;
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: var(--surface-raised);
    color: var(--ink);
    box-shadow: var(--shadow-raised);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .filter-sheet::backdrop {
    background: var(--scrim);
  }
  .sheet-header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
    background: var(--surface-raised);
  }
  .sheet-close {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: 0;
    border-radius: var(--radius-badge);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .filter-form {
    display: grid;
    gap: var(--space-4);
  }
  .filter-group {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0 0 var(--space-4);
    border: 0;
    border-bottom: 1px solid var(--border);
    min-width: 0;
  }
  .filter-group legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-weight: var(--weight-semibold);
  }
  .filter-group .option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    cursor: pointer;
  }
  .filter-group .option input {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--brand);
  }
  .filter-group .hint {
    color: var(--ink-muted);
    font-size: var(--text-small);
  }
  .filter-group .range {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .filter-group .number {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-small);
    color: var(--ink-muted);
  }
  .filter-group .number input {
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--ink-muted);
    border-radius: var(--radius-input);
    background: var(--surface-raised);
    color: var(--ink);
    font-size: var(--text-body);
    width: 100%;
    min-width: 0;
  }
  .filter-actions {
    position: sticky;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-3);
    background: var(--surface-raised);
  }
  .filter-actions .button[type='submit'] {
    flex: 1 1 auto;
  }

  /* Desktop: a column beside the results, always open. */
  @media (min-width: 1024px) {
    .filter-sheet,
    .filter-sheet:not(:popover-open) {
      display: block;
      position: sticky;
      top: var(--space-4);
      inset: auto;
      max-height: calc(100dvh - 2 * var(--space-4));
      padding: var(--space-4);
      border-radius: var(--radius-card);
      border: 1px solid var(--border);
      box-shadow: none;
    }
    .sheet-close {
      display: none;
    }
    .sheet-header {
      position: static;
      padding-top: 0;
    }
  }
</style>
