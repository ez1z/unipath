---
import { getTranslations, type Lang } from '../i18n';
import { formatDate } from '../lib/format';

/**
 * Key answers for a record, then "Last checked [date] · Source · Report a mistake".
 * Facts go in the default slot as <div><dt/><dd/></div>; buttons in "actions".
 */
interface Props {
  lang: Lang;
  lastChecked: string;
  sourceUrl: string | null;
  /** Link to the Report a mistake form for this record. */
  reportHref: string;
  id?: string;
}
const { lang, lastChecked, sourceUrl, reportHref, id = 'summary' } = Astro.props;
const t = getTranslations(lang);
---

<section class="summary" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="visually-hidden">
    {t('summary.title')}
  </h2>
  <slot name="badges" />
  <dl class="facts">
    <slot />
  </dl>
  {Astro.slots.has('actions') && (
    <div class="actions">
      <slot name="actions" />
    </div>
  )}
  <p class="meta">
    <span>{t('common.lastChecked', { date: formatDate(lang, lastChecked) })}</span>
    {sourceUrl && (
      <>
        <span aria-hidden="true">·</span>
        <a href={sourceUrl} rel="noopener noreferrer" target="_blank">
          {t('common.source')}
        </a>
      </>
    )}
    <span aria-hidden="true">·</span>
    <a href={reportHref} rel="nofollow">
      {t('common.reportMistake')}
    </a>
  </p>
</section>

<style>
  .summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-card-large);
    background: var(--surface-raised);
    border: 1px solid var(--border);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
</style>
