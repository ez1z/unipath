{
  "name": "clavis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/seed.ts",
    "db:backup": "node scripts/backup-now.ts",
    "db:import": "node scripts/import-records.ts",
    "db:import-moe": "node scripts/import-moe-list.ts",
    "make-admin": "node scripts/make-admin.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "security:headers": "node scripts/write-headers.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.4",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.2",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/preact": "6.1.6",
    "@fontsource/onest": "5.3.1",
    "astro": "7.4.13",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "preact": "11.2.0",
    "zod": "4.6.7"
  }
}
