  "support": {
    "title": "Support & FAQ",
    "subtitle": "Learn about UniPath and find answers to common questions",
    "about_title": "About UniPath",
    "about_desc": "UniPath is a free guide platform helping Turkmenistan students discover universities abroad, compare options, and understand the official tuition transfer process through the Ministry of Education.",
    "about_free": "100% Free",
    "about_free_desc": "UniPath is completely free for all students. No subscriptions or hidden fees.",
    "about_guide_only": "Guide Only",
    "about_guide_only_desc": "We provide information and guidance only. We never process payments or submit applications.",
    "about_moe": "MoE Aligned",
    "about_moe_desc": "Our platform reflects the official MoE transfer rules and approved university list.",
    "faq_title": "Frequently Asked Questions",
    "faq_what_title": "What is UniPath?",
    "faq_what_body": "UniPath is an independent guide platform for Turkmenistan students planning to study abroad. You can search and compare universities, track your application documents, and learn about the official tuition transfer process — all in one place. UniPath is free and does not handle money or visa applications.",
    "faq_moe_title": "What does 'MoE Approved' mean?",
    "faq_moe_body": "The 'MoE Approved' badge means the university is on the official list approved by the Turkmenistan Ministry of Education. Only these universities qualify for the official $12,000/year tuition transfer through a licensed Turkmen bank.",
    "faq_cap_title": "What is the $12,000 transfer cap?",
    "faq_cap_body": "Turkmenistan allows students to officially transfer up to $12,000 USD per year for tuition at MoE-approved universities. At the fixed Central Bank rate of 3.51 TMT per USD, this equals 42,120 TMT annually. Use our Transfer Calculator to compute exact amounts.",
    "faq_payment_title": "Does UniPath process tuition payments?",
    "faq_payment_body": "No. UniPath is a guide platform only and never handles money. To make a tuition transfer, you must visit a licensed Turkmen bank (e.g., Türkmenbank, Halkbank) in person with your tuition invoice and student documents.",
    "faq_tracker_title": "How does the Application Tracker work?",
    "faq_tracker_body": "The tracker lets you save dream universities, track documents needed for each application, and monitor your progress. Create a free account and sign in to access it. Your data is private and only visible to you.",
    "faq_compare_title": "How do I compare universities?",
    "faq_compare_body": "Go to the Universities page, click 'Compare' on up to 3 universities, then visit the Compare page to see them side by side — tuition, ranking, languages, majors, and MoE status.",
    "faq_language_title": "How do I change the language?",
    "faq_language_body": "Use the TK / RU / EN buttons in the top navigation bar. UniPath is available in Turkmen, Russian, and English. Your language preference is saved automatically.",
    "faq_contact_title": "How can I contact UniPath?",
    "faq_contact_body": "For questions or feedback, email us at unipathtm@gmail.com. We aim to respond within 2 business days.",
    "contact_title": "Still have questions?",
    "contact_desc": "Send us a message — we're happy to help.",
    "contact_email": "Email support"
  },
