// Cloudflare Worker config for Clavis.
// Top level: local dev and tests (`astro dev`, `astro preview`, local D1, R2 and KV in .wrangler/).
// `env.production`: the live site. Built with CLOUDFLARE_ENV=production (see DEPLOY.md);
// its IDs, domain and bot name are placeholders until Eziz creates the resources.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clavis",
  // Astro's handler plus the cron (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clavis",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "clavis-files",
    },
  ],
  // Rate limits (work locally in wrangler / astro preview).
  // REPORT_LIMITER: "Report a mistake", per IP. AUTH_LIMITER: sign-in code requests and
  // sign-in attempts, per IP. WRITE_LIMITER: account writes (save, profile), per user.
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Local defaults. Secrets (BETTER_AUTH_SECRET, TELEGRAM_BOT_TOKEN, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET) live in .dev.vars locally and in Wrangler secrets in production.
  // TELEGRAM_BOT_TOKEN checks Telegram sign-in (Login Widget, Mini App) and sends Telegram
  // reminders; on localhost reminders only print to the console.
  // DEV_MAILBOX lets local tests read sign-in codes; it only works on localhost.
  "vars": {
    "SITE_URL": "http://localhost:4321",
    "TELEGRAM_BOT_USERNAME": "clavis_dev_bot",
    "EMAIL_FROM": "no-reply@clavis.example",
    "DEV_MAILBOX": "1",
  },
  // UTC. 04:00 = 09:00 Ashgabat: deadline reminders. 23:00 = 04:00 Ashgabat: D1 backup to R2.
  // Both in src/lib/scheduled.ts.
  "triggers": { "crons": ["0 4 * * *", "0 23 * * *"] },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000",
    },
  ],
  // The live site. Bindings and vars are not inherited from the top level, so each is
  // repeated here. Every REPLACE_… value comes from DEPLOY.md step by step.
  "env": {
    "production": {
      "name": "clavis",
      // No domain yet (2026-11-29): the site runs on the account's workers.dev address.
      // With a domain, add `"routes": [{ "pattern": "the-domain", "custom_domain": true }]`,
      // set SITE_URL to it and workers_dev to false (DEPLOY.md, "Moving to a domain").
      // Preview URLs for uploaded versions (`wrangler versions upload`), before they go live.
      "preview_urls": true,
      "workers_dev": true,
      // Worker logs in the Cloudflare dashboard (no third-party service).
      "observability": { "enabled": true },
      "vars": {
        "SITE_URL": "https://clavis.clavis-548.workers.dev",
        "TELEGRAM_BOT_USERNAME": "myclavisbot",
        // Email is off in production (Eziz, 2026-11-28): sign-in with Telegram or Google,
        // reminders by Telegram. To turn it on, set an address here and add the
        // send_email binding below (DEPLOY.md, "Turning email on").
        "EMAIL_FROM": "",
        // Off: the local test mailbox ("1") never exists in production.
        "DEV_MAILBOX": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clavis-production",
          "database_id": "a6ef7f8a-bd14-43ca-90a7-f6cfe4a85727",
          "migrations_dir": "migrations",
        },
      ],
      // File storage (R2) is off for now (Eziz, 2026-11-29: R2 asks for a card): no
      // logo/photo uploads, no nightly backup (src/lib/server.ts filesBucket). To turn it
      // on, add `"r2_buckets": [{ "binding": "FILES", "bucket_name": "clavis-files-production" }]`
      // (DEPLOY.md, "Turning file storage on").
      "kv_namespaces": [{ "binding": "KV", "id": "f753ac86aa5945b5b2d13d883872e9c7" }],
      "ratelimits": [
        {
          "name": "REPORT_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 },
        },
        { "name": "AUTH_LIMITER", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
        {
          "name": "WRITE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
  },
}
